# RECALL Configuration Environment Variables

# API Server Host and Port
RECALL_API_HOST=0.0.0.0
RECALL_API_PORT=8080

# CORS Allowed Origins (comma-separated list of origins)
RECALL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Canonical SQLite Storage Path (default: ~/.recall/recall.sqlite3)
# RECALL_DB_PATH=/path/to/custom/recall.sqlite3

# Optional Core MemoryManager Custom Factory override for MCP
# RECALL_CORE_FACTORY=recall_core.bootstrap:create_memory_manager

# Local Embedding Configuration (default: sentence-transformers/all-MiniLM-L6-v2 on cpu)
# RECALL_EMBEDDING_PROVIDER=sentence-transformers
# RECALL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RECALL_EMBEDDING_DEVICE=cpu

# MCP Startup Warmup (default: true)
# Pre-initializes embedding model and performs a 1-token forward pass at startup
# to eliminate cold-start latency on the first search query. Set to false to disable.
# RECALL_MCP_WARMUP=true

# Local LLM Conflict Arbitration (Ollama)
# RECALL_LOCAL_LLM_MODEL=qwen2.5:3b
# RECALL_LOCAL_LLM_BASE_URL=http://localhost:11434
# RECALL_LOCAL_LLM_TIMEOUT=30

# Optional Cloud LLM Overflow Arbitration (used only on local context window overflow)
# Supported providers: openai, anthropic, gemini
# RECALL_CONFLICT_CLOUD_PROVIDER=openai
# RECALL_CONFLICT_CLOUD_API_KEY=your-api-key
# RECALL_CONFLICT_CLOUD_MODEL=gpt-4o-mini
# RECALL_CONFLICT_CLOUD_BASE_URL=https://api.openai.com/v1
# RECALL_CONFLICT_CLOUD_TIMEOUT=30
